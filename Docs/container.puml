@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Container Diagram for DE-Store MSOA

' Actors
Person(localMgr, "Store Manager", "Manages single-store pricing and stock")
Person(netMgr, "Network Manager", "Manages network-wide pricing and loyalty")
System_Ext(shoppingSys, "Shopping System", "External POS/E-commerce")

System_Boundary(c1, "DE-Store MSOA") {
    ' Core Infra
    Container(spa, "Management SPA", "React/Angular", "Dashboard for Local & Network Managers")
    Container(apiGw, "API Gateway", "Nginx/Kong", "Routes requests, JWT validation, Rate limiting")
    ContainerQueue(msgBus, "Message Bus", "RabbitMQ/Kafka", "Event-driven messaging for LowStock, PriceChanged, LoyaltyUpdated")

    ' Domain Services
    Container(authSvc, "Auth Service", "Microservice", "Issues/Validates JWT, RBAC (Store vs Network roles)")
    Container(priceSvc, "Pricing Service", "Microservice", "Calculates prices with hierarchical rules (Global + Store overrides)")
    Container(loyaltySvc, "Loyalty Service", "Microservice", "Network-wide loyalty points and promotional campaigns")
    Container(invSvc, "Inventory Service", "Microservice", "Syncs with Central Warehouse DB 1-2 times daily, generates low stock alerts")
    Container(finSvc, "Finance Adapter", "Microservice", "Proxy to Enabling Finance System with request validation")
    Container(reportSvc, "Reporting Service", "Microservice", "Anti-corruption layer: reads Accounting DB, generates analytics")
    Container(notifySvc, "Notification Service", "Microservice", "Event-driven email alerts (LowStock, etc.)")

    ' Data Stores (Per-Service Isolation)
    ContainerDb(priceDB, "Pricing DB", "NoSQL/PostgreSQL", "Hierarchical pricing rules (Global + Store-specific)")
    ContainerDb(loyaltyDB, "Loyalty DB", "PostgreSQL", "Customer profiles, points, network-wide offers")
}

' External Dependencies
System_Ext(warehouseDB, "Central Warehouse DB", "Legacy Read-Only JDBC")
System_Ext(accountingDB, "Central Accounting DB", "Legacy Read-Only JDBC")
System_Ext(enablingSys, "Enabling Finance API", "External BNPL System")
System_Ext(email, "Email System", "SMTP")

' --- Interactions ---

' 1. Manager Interactions
Rel(localMgr, spa, "Configure Store Settings", "HTTPS/TLS 1.3")
Rel(netMgr, spa, "Configure Global Pricing/Loyalty", "HTTPS/TLS 1.3")
Rel(spa, apiGw, "Management API Calls", "REST/JSON over HTTPS")

' 2. Shopping System - Transaction Flow (Price & Loyalty only)
Rel(shoppingSys, apiGw, "Get Final Price (Promotions + Loyalty)", "REST/JSON over HTTPS")
Rel(shoppingSys, apiGw, "Request Finance Approval", "REST/JSON over HTTPS")

' 3. API Gateway Routing
Rel(apiGw, authSvc, "Validate JWT & Check Role", "REST/JSON over HTTPS")
Rel(apiGw, priceSvc, "Calculate Final Price", "REST/JSON over HTTPS")
Rel(apiGw, loyaltySvc, "Apply Loyalty Discount", "REST/JSON over HTTPS")
Rel(apiGw, finSvc, "Proxy Finance Request", "REST/JSON over HTTPS")
Rel(apiGw, reportSvc, "Generate Reports", "REST/JSON over HTTPS")

' 4. Service Data Access
Rel(priceSvc, priceDB, "Read/Write Pricing Rules", "MongoDB Wire Protocol / PostgreSQL Protocol")
Rel(loyaltySvc, loyaltyDB, "Read/Write Loyalty Data", "PostgreSQL Protocol (TCP/5432)")

' 5. Legacy System Integration (Daily Batch Operations)
Rel(invSvc, warehouseDB, "Daily Sync (1-2 times/day)", "JDBC over TCP")
Rel(reportSvc, accountingDB, "Query Sales History", "JDBC over TCP")

' 6. External System Integration
Rel(finSvc, enablingSys, "Forward Finance Request", "REST/JSON or SOAP/XML over HTTPS")
Rel(notifySvc, email, "Send Alerts", "SMTP/TLS (TCP/587)")

' 7. Event-Driven Messaging
Rel(invSvc, msgBus, "Publish 'LowStockEvent'", "AMQP 0-9-1 / Kafka Protocol")
Rel(priceSvc, msgBus, "Publish 'PriceChangedEvent'", "AMQP 0-9-1 / Kafka Protocol")
Rel(loyaltySvc, msgBus, "Publish 'LoyaltyUpdatedEvent'", "AMQP 0-9-1 / Kafka Protocol")
Rel(notifySvc, msgBus, "Subscribe to Events", "AMQP 0-9-1 / Kafka Protocol")
Rel(reportSvc, msgBus, "Subscribe for Analytics", "AMQP 0-9-1 / Kafka Protocol")

SHOW_LEGEND()
@enduml