@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Container Diagram for DE-Store MSOA

' Actors
Person(localMgr, "Store Manager", "Manages single-store pricing and stock")
Person(netMgr, "Network Manager", "Manages network-wide pricing, loyalty, and analytics")

System_Boundary(c1, "DE-Store MSOA") {
    ' Core Infrastructure
    Container(spa, "Management UI", "HTML5/CSS3/JavaScript", "Static web dashboard for Local & Network Managers with role-based access")
    Container(apiGw, "API Gateway", "Nginx", "Routes requests, CORS handling, Rate limiting (100-300 req/min)")

    ' Domain Services
    Container(authSvc, "Auth Service", "Spring Boot 3.2.0 + JWT", "Authentication, JWT token issuance/validation, RBAC (Store vs Network roles)")
    Container(storeSvc, "Store Service", "Spring Boot 3.2.0", "Manages store locations and metadata (CRUD for Network, read-only for Store managers)")
    Container(priceSvc, "Pricing Service", "Spring Boot 3.2.0", "Calculates prices with hierarchical rules (Global + Store overrides), product points configuration")
    Container(loyaltySvc, "Loyalty Service", "Spring Boot 3.2.0", "Points calculation, redemption offers, basket pricing with SAGA pattern, scheduled points processing")
    Container(invSvc, "Inventory Service", "Spring Boot 3.2.0", "Monitors warehouse stock, generates low/critical/out-of-stock email alerts every 6 hours")
    Container(analyticsSvc, "Analytics Service", "Spring Boot 3.2.0", "Read-only multi-database reporting: revenue, transactions, products, stores (Network Manager only)")
    Container(financeAdapter, "Finance Adapter", "Spring Boot 3.2.0", "Anti-corruption layer for Enabling Finance BNPL API integration")

    ' Data Stores (Per-Service Database Isolation)
    ContainerDb(authDB, "Auth DB", "PostgreSQL 15:5433", "User credentials, roles (STORE_MANAGER/NETWORK_MANAGER), JWT refresh tokens")
    ContainerDb(storeDB, "Store DB", "PostgreSQL 15:5434", "Store locations: store_id, store_code, store_name, address, postcode, active status")
    ContainerDb(priceDB, "Pricing DB", "PostgreSQL 15:5432", "Hierarchical pricing rules, product points rules, bonus offers")
    ContainerDb(loyaltyDB, "Loyalty DB", "PostgreSQL 15:5436", "Customer balances, points transactions, redemption offers, usage tracking")
}

' External Dependencies (Legacy Systems)
System_Ext(warehouseDB, "Central Warehouse DB", "MySQL 8:3306 (Legacy, Read-Only)")
System_Ext(accountingDB, "Central Accounting DB", "PostgreSQL 15:5435 (Legacy, Read-Only)")

' External Dependencies (Externl systems)
System_Ext(shoppingSys2, "Shopping System", "Spring Boot 3.2.0 - Test implementation")
System_Ext(enablingMock, "Enabling Finance System", "Node.js:8095 - Test implementation")
System_Ext(mailhog, "Email Server", "SMTP:1025, Web UI:8025")

' --- Interactions ---

' 1. Manager UI Interactions
Rel(localMgr, spa, "Configure Store Pricing Rules", "HTTPS")
Rel(netMgr, spa, "Configure Global Pricing/Loyalty/View Analytics", "HTTPS")
Rel(spa, apiGw, "Management API Calls", "REST/JSON over HTTP")

' 2. Shopping System - Transaction Flow
Rel(shoppingSys2, apiGw, "Calculate Points for Transactions", "REST/JSON over HTTP")
Rel(shoppingSys2, apiGw, "Get Customer Points Balance", "REST/JSON over HTTP")
Rel(shoppingSys2, apiGw, "Price Basket with Redemption Offers (SAGA)", "REST/JSON over HTTP")
Rel(shoppingSys2, apiGw, "Calculate Final Price with Hierarchical Rules", "REST/JSON over HTTP")

' 3. Test Harness (Development/Testing Only)
Rel(shoppingSys2, apiGw, "Test Points Calculation & Redemption via API Gateway", "REST/JSON over HTTP")
Rel(shoppingSys2, apiGw, "Test Edge Cases (Concurrency, Invalid Data)", "REST/JSON over HTTP")

' 4. API Gateway Routing
Rel(apiGw, authSvc, "JWT Validation & Authentication", "REST/JSON over HTTP:8081")
Rel(apiGw, storeSvc, "Store Management API", "REST/JSON over HTTP:8083")
Rel(apiGw, priceSvc, "Price Calculation & Rules Management", "REST/JSON over HTTP:8080")
Rel(apiGw, loyaltySvc, "Points & Basket Pricing API", "REST/JSON over HTTP:8085")
Rel(apiGw, analyticsSvc, "Analytics & Reporting API (Network Manager only)", "REST/JSON over HTTP:8086")
Rel(apiGw, invSvc, "Inventory Monitoring API", "REST/JSON over HTTP:8084")
Rel(apiGw, financeAdapter, "Finance Approval Requests", "REST/JSON over HTTP:8091")

' 5. Service Data Access (Primary Databases)
Rel(authSvc, authDB, "Read/Write User Credentials & Roles", "JDBC/PostgreSQL:5433")
Rel(storeSvc, storeDB, "Read/Write Store Metadata", "JDBC/PostgreSQL:5434")
Rel(priceSvc, priceDB, "Read/Write Pricing Rules & Product Points", "JDBC/PostgreSQL:5432")
Rel(loyaltySvc, loyaltyDB, "Read/Write Points Balances & Redemptions", "JDBC/PostgreSQL:5436")

' 6. Cross-Service Dependencies
Rel(priceSvc, storeSvc, "Fetch Store Information for Rule Validation", "REST/JSON over HTTP:8083")
Rel(priceSvc, warehouseDB, "Read Product Catalog (Read-Only)", "JDBC/MySQL:3306")

' 7. Legacy System Integration (Read-Only Access)
Rel(invSvc, warehouseDB, "Monitor Stock Levels (Read-Only)", "JDBC/MySQL:3306")
Rel(invSvc, authDB, "Read Network Manager Emails (Read-Only)", "JDBC/PostgreSQL:5433")
Rel(loyaltySvc, accountingDB, "Query Customer Transactions for Points Calculation (Read-Only)", "JDBC/PostgreSQL:5435")

' 8. Analytics Multi-Database Read Pattern
Rel(analyticsSvc, accountingDB, "Read Transaction & Financial Data (Read-Only)", "JDBC/PostgreSQL:5435")
Rel(analyticsSvc, storeDB, "Read Store Metadata for Enrichment (Read-Only)", "JDBC/PostgreSQL:5434")
Rel(analyticsSvc, warehouseDB, "Read Product Catalog for Enrichment (Read-Only)", "JDBC/MySQL:3306")

' 9. Finance Integration
Rel(financeAdapter, enablingMock, "BNPL Approval Requests", "REST/JSON over HTTP:8095")

' 10. Email Notifications
Rel(invSvc, mailhog, "Send Low Stock Alert Emails (Scheduled)", "SMTP:1025")

' 11. Scheduled Background Processes
Rel(loyaltySvc, loyaltySvc, "SAGA Orchestration:\n1. Validate offers\n2. Reserve points\n3. Calculate discounts\n4. Compensate on failure", "Internal")
Rel(loyaltySvc, loyaltySvc, "Scheduled Points Calculation\n(Every 6 hours via @Scheduled)", "Internal Cron")
Rel(invSvc, invSvc, "Scheduled Stock Monitoring\n(Every 6 hours via @Scheduled)", "Internal Cron")

SHOW_LEGEND()
@enduml