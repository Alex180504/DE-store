@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Container Diagram for DE-Store MSOA

' Actors
Person(localMgr, "Store Manager", "Manages single-store pricing and stock")
Person(netMgr, "Network Manager", "Manages network-wide pricing and loyalty")
System_Ext(shoppingSys, "Shopping System", "External POS/E-commerce")

System_Boundary(c1, "DE-Store MSOA") {
    ' Core Infra
    Container(spa, "Management SPA", "React/Angular", "Dashboard for Local & Network Managers")
    Container(apiGw, "API Gateway", "Nginx", "Routes requests, JWT validation, Rate limiting")
    Container(mockSvc, "Shopping Mock Service", "Spring Boot", "Test harness for loyalty integration testing with edge cases")

    ' Domain Services
    Container(authSvc, "Auth Service", "Spring Boot + JWT", "Issues/Validates JWT, RBAC (Store vs Network roles)")
    Container(storeSvc, "Store Service", "Spring Boot", "Manages store locations and metadata (CRUD for Network, read-only for Store managers)")
    Container(priceSvc, "Pricing Service", "Spring Boot", "Calculates prices with hierarchical rules (Global + Store overrides)")
    Container(loyaltySvc, "Loyalty Service", "Spring Boot", "Points calculation, redemption offers, basket pricing with SAGA pattern")
    Container(invSvc, "Inventory Service", "Spring Boot", "Syncs with Central Warehouse DB, generates low stock alerts")

    ' Data Stores (Per-Service Isolation)
    ContainerDb(authDB, "Auth DB", "PostgreSQL:5433", "User credentials, roles, JWT refresh tokens")
    ContainerDb(storeDB, "Store DB", "PostgreSQL:5434", "Store locations: code, name, address, postcode, active status")
    ContainerDb(priceDB, "Pricing DB", "PostgreSQL:5435", "Hierarchical pricing rules, product points rules, bonus offers")
    ContainerDb(loyaltyDB, "Loyalty DB", "PostgreSQL:5436", "Customer balances, points transactions, redemption offers, usage tracking")
}

' External Dependencies
System_Ext(warehouseDB, "Central Warehouse DB", "Legacy PostgreSQL (Read-Only)")
System_Ext(accountingDB, "Central Accounting DB", "PostgreSQL:5435 (Read-Only)")
System_Ext(enablingSys, "Enabling Finance API", "External BNPL System")
System_Ext(email, "Email System", "SMTP")

' --- Interactions ---

' 1. Manager Interactions
Rel(localMgr, spa, "Configure Store Settings", "HTTPS/TLS 1.3")
Rel(netMgr, spa, "Configure Global Pricing/Loyalty Rules", "HTTPS/TLS 1.3")
Rel(spa, apiGw, "Management API Calls", "REST/JSON over HTTPS")

' 2. Shopping System - Transaction Flow
Rel(shoppingSys, apiGw, "Calculate Points for Transactions", "REST/JSON over HTTPS")
Rel(shoppingSys, apiGw, "Get Customer Points Balance", "REST/JSON over HTTPS")
Rel(shoppingSys, apiGw, "Price Basket with Redemption Offers (SAGA)", "REST/JSON over HTTPS")
Rel(shoppingSys, apiGw, "Request Finance Approval", "REST/JSON over HTTPS")

' 3. Test Harness
Rel(mockSvc, loyaltySvc, "Test Points Calculation & Redemption", "REST/JSON over HTTP")
Rel(mockSvc, loyaltySvc, "Test Edge Cases (Concurrency, Invalid Data)", "REST/JSON over HTTP")

' 4. API Gateway Routing
Rel(apiGw, authSvc, "Validate JWT & Check Role", "REST/JSON over HTTP:8083")
Rel(apiGw, storeSvc, "Manage Store Locations", "REST/JSON over HTTP:8082")
Rel(apiGw, priceSvc, "Calculate Final Price", "REST/JSON over HTTP:8084")
Rel(apiGw, loyaltySvc, "Points Calculation & Basket Pricing", "REST/JSON over HTTP:8085")

' 5. Service Data Access
Rel(authSvc, authDB, "Read/Write User Credentials & Roles", "PostgreSQL Protocol (TCP/5433)")
Rel(storeSvc, storeDB, "Read/Write Store Metadata", "PostgreSQL Protocol (TCP/5434)")
Rel(priceSvc, priceDB, "Read/Write Pricing Rules & Product Points", "PostgreSQL Protocol (TCP/5435)")
Rel(priceSvc, storeSvc, "Fetch Store Information", "REST/JSON over HTTP")
Rel(loyaltySvc, loyaltyDB, "Read/Write Points Balances & Redemptions", "PostgreSQL Protocol (TCP/5436)")
Rel(loyaltySvc, accountingDB, "Read Transaction History for Points", "PostgreSQL Protocol (TCP/5435)")
Rel(spa, storeSvc, "Query Store List for Dropdowns", "REST/JSON over HTTPS")

' 6. Legacy System Integration
Rel(invSvc, warehouseDB, "Daily Sync (1-2 times/day)", "JDBC over TCP")
Rel(loyaltySvc, accountingDB, "Query Customer Transactions for Points Calculation", "JDBC over TCP")

' 7. Loyalty Service Internal Components
Rel(loyaltySvc, loyaltySvc, "SAGA Orchestration:\n1. Validate offers\n2. Reserve points\n3. Calculate discounts\n4. Compensate on failure", "Internal")

SHOW_LEGEND()
@enduml